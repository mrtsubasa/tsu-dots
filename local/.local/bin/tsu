#!/usr/bin/env bash
# tsu - Dotfiles management CLI

DOTS_DIR="$HOME/.tsu-dots"
CMD_DIR="$DOTS_DIR/.data/tsu-cli/commands"

cmd="${1:-help}"
[[ "$cmd" == "--help" || "$cmd" == "-h" ]] && cmd="help"
shift 2>/dev/null || true

cmd_file="$CMD_DIR/$cmd.sh"
if [[ -f "$cmd_file" ]]; then
    # Run inside a function so 'local' and 'return' work in sourced files
    _tsu_run() {
        source "$cmd_file" "$@"
    }
    _tsu_run "$@"
else
    echo "tsu: unknown command '$cmd'"
    echo "Run 'tsu help' for usage information."
    exit 1
fi
